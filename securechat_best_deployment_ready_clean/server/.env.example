DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
NODE_ENV=development
PORT=8080

# Optional social login. Add these on Render before enabling the buttons in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email OTP password reset (Resend). If unset, OTP codes are logged to the server console instead.
RESEND_API_KEY=
RESEND_FROM=SecureChat <onboarding@resend.dev>

# Web Push (VAPID) for waking the app to ring incoming calls when it's backgrounded/closed.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Cloudflare R2 (S3-compatible) storage for the Flicks video feed. If unset, video
# upload/feed endpoints return 503 and the feature is disabled.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
