DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
NODE_ENV=development
PORT=8080

# Optional social login. Add these on Render before enabling the buttons in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email OTP password reset (Resend). If unset, OTP codes are logged to the server console instead.
RESEND_API_KEY=
RESEND_FROM=SecureChat <onboarding@resend.dev>

# Web Push (VAPID) for waking the app to ring incoming calls when it's backgrounded/closed.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# S3-compatible object storage for the Flicks video feed (Cloudflare R2, Supabase
# Storage, AWS S3, etc). If unset, upload endpoints return 503 and the feature is
# disabled. STORAGE_REGION defaults to 'auto' (fine for R2); set it to your actual
# region for providers like Supabase/AWS that require one (e.g. 'us-east-2').
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
